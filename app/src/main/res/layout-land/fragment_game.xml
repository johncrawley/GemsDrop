<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/game_layout"
    android:background="@drawable/background_1"

    android:gravity="center"
    android:weightSum="1"
    android:tileMode="mirror">


        <include layout="@layout/game_score"
            android:id="@+id/game_score_include"
            android:layout_width="120dp"
            android:layout_height="90dp"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <include layout="@layout/game_gems_preview"
            android:id="@+id/game_preview_include"
            android:layout_width="wrap_content"
            android:layout_height="90dp"
            android:layout_margin="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

    <LinearLayout
        android:id="@+id/game_pane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="top|center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/game_score_include"
        app:layout_constraintEnd_toStartOf="@id/game_preview_include"
        android:layout_weight=".90">

        <LinearLayout
            android:id="@+id/container_border"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="0dp"
            android:paddingHorizontal="2dp"
            android:paddingBottom="2dp"
            android:background="?attr/gridBorderColor"
            tools:ignore="UselessParent">
            <FrameLayout
                android:id="@+id/gemContainer"
                android:background="@color/colorPrimaryDark"
                android:layout_width="100dp"
                android:layout_height="300dp"
                android:foregroundGravity="center" />
        </LinearLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>